  "cards": [
    {
      "dot": "cyan",
      "title": "Verification Workflow Steps",
      "items": [
        "1. Multi-Modal Intake: Scans QR/barcode, OCR packaging photo, or accepts manual form input",
        "2. Data Extraction: Extracts product name, batch number, GTIN, manufacturing and expiry dates",
        "3. Verification & CDSCO Checks: Queries catalog database, openFDA info, and CDSCO alert notices",
        "4. Risk Analysis: Computes 0-100 screening risk score and categorizes into Low, Medium, or High concern",
        "5. Bilingual Output: Generates accessible English & Hindi explanations with Sarvam voice synthesis",
        "6. Reporting: Allows users to report suspicious packaging or flagged batches directly to admins"
      ]
    }
  ]
