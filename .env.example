# ==============================================================================
# MediFy (Med-Verify) Unified Environment Configuration Template
# Copy this file to `.env` or `.env.local`. Never commit real secrets.
# ==============================================================================

# ── Frontend (Vite / React) Configuration ──
VITE_APP_ENV=development

# Future Official Regulatory Directory API (e.g. CDSCO Sugam / FDA NDC / GS1)
VITE_REGULATORY_API_URL=https://api.example-regulator.gov/v1
VITE_REGULATORY_API_KEY=your_sandbox_api_key_here

# Future LLM / AI Assistant Integration for MediBot
VITE_AI_ASSISTANT_ENDPOINT=https://api.example-ai.com/v1/chat
VITE_AI_ASSISTANT_KEY=your_ai_service_key_here

# Toggle Local Demo Reference Catalog Fallback (default: true)
VITE_ENABLE_DEMO_CATALOG=true

# ── Backend (FastAPI / Python) Configuration ──
ENVIRONMENT=development
DEBUG=True
PORT=8000
SECRET_KEY=medify-secret-key-change-in-production
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# Database
# Option 1: SQLite for quick local offline development
DATABASE_URL=sqlite+aiosqlite:///medverify.db
# Option 2: PostgreSQL / Supabase
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/medverify

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your_supabase_anon_or_service_key
SUPABASE_JWT_SECRET=your_jwt_secret

# External AI & OCR Services
SARVAM_API_KEY=your_sarvam_api_key
OCR_SPACE_API_KEY=your_ocr_space_api_key
OPENFDA_API_KEY=your_openfda_api_key
GEMINI_API_KEY=your_google_gemini_api_key
